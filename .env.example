# Admin password used to log in at /admin/login
ADMIN_PASSWORD=change-me-to-something-strong

# Random long random string used to sign the admin session cookie.
# Generate one with: openssl rand -hex 32
SESSION_SECRET=change-me-to-a-long-random-string

# Discord webhook URL (Server Settings -> Integrations -> Webhooks -> New Webhook -> Copy URL)
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/xxxxx/xxxxx

# Upstash Redis credentials (created via Vercel Marketplace -> Upstash, or upstash.com directly)
UPSTASH_REDIS_REST_URL=https://xxxxx.upstash.io
UPSTASH_REDIS_REST_TOKEN=xxxxx
